# Identity provider. Use the public key for asymmetric signatures where possible.
JWT_PUBLIC_KEY=
# Set JWT_SECRET only for an external HS256 issuer; never commit its value.
JWT_SECRET=
JWT_MAX_AGE=1h
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JSON_BODY_LIMIT=8mb

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pps_user
DB_PASSWORD=change-me-local
DB_NAME=pps_db
